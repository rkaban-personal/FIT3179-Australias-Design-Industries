{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Eight selected occupations: published female and part-time percentages; symbol area represents rounded employment. Leader lines connect text annotations to data points. Experimental 2021 Census estimates reclassified to OSCA 2024.",
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "background": "transparent",
    "font": "\"Source Sans 3\"",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 16,
      "titleFontSize": 18,
      "titleFontWeight": "normal",
      "labelColor": "#253c39",
      "titleColor": "#253c39",
      "gridColor": "#dedfd4",
      "domainColor": "#9cae9f",
      "tickColor": "#9cae9f",
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 16,
      "titleFontSize": 17,
      "labelColor": "#253c39",
      "titleColor": "#253c39",
      "orient": "bottom",
      "titleLimit": 360,
      "labelLimit": 260,
      "titlePadding": 12,
      "rowPadding": 14,
      "columnPadding": 24,
      "labelOffset": 8
    },
    "text": {
      "font": "\"Source Sans 3\"",
      "fontSize": 16,
      "color": "#253c39"
    }
  },
  "data": {
    "url": "data/workforce.json"
  },
  "transform": [
    {
      "calculate": "width < 500 ? datum.label_x_narrow : datum.label_x_wide",
      "as": "label_x"
    },
    {
      "calculate": "width < 500 ? datum.label_y_narrow : datum.label_y_wide",
      "as": "label_y"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#285f60",
        "opacity": 0.8,
        "stroke": "#f6f3eb",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "female_pct",
          "type": "quantitative",
          "title": "Female share (%)",
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ]
          },
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "field": "part_time_pct",
          "type": "quantitative",
          "title": "Part-time share (%)",
          "axis": {
            "values": [
              0,
              10,
              20,
              30,
              40,
              50
            ]
          },
          "scale": {
            "domain": [
              0,
              52
            ]
          }
        },
        "size": {
          "field": "employment",
          "type": "quantitative",
          "title": "People (rounded)",
          "scale": {
            "domain": [
              0,
              27000
            ],
            "range": [
              0,
              1800
            ]
          },
          "legend": {
            "values": [
              3000,
              12000,
              27000
            ]
          }
        },
        "tooltip": [
          {
            "field": "occupation",
            "type": "nominal",
            "title": "occupation"
          },
          {
            "field": "employment",
            "type": "quantitative",
            "title": "People (rounded)",
            "format": ","
          },
          {
            "field": "female_pct",
            "type": "quantitative",
            "title": "Female (%)"
          },
          {
            "field": "part_time_pct",
            "type": "quantitative",
            "title": "Part-time (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#253c39",
        "opacity": 0.45,
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "female_pct",
          "type": "quantitative"
        },
        "y": {
          "field": "part_time_pct",
          "type": "quantitative"
        },
        "x2": {
          "field": "label_x"
        },
        "y2": {
          "field": "label_y"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": {
          "expr": "width < 500 ? 14 : 15"
        },
        "align": {
          "expr": "datum.label == 'Architect' || datum.label == 'Industrial' ? 'left' : 'center'"
        },
        "stroke": "#f6f3eb",
        "strokeWidth": 5
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": {
          "expr": "width < 500 ? 14 : 15"
        },
        "align": {
          "expr": "datum.label == 'Architect' || datum.label == 'Industrial' ? 'left' : 'center'"
        },
        "color": "#253c39"
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
